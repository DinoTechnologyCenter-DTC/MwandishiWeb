# Copy to .env and uncomment + fill in. NEVER commit .env (it is gitignored).
# Uncommented values here OVERRIDE real environment variables.

# Groq (primary AI) — get one at console.groq.com
# GROQ_API_KEY=gsk_...
# Optional model override (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Cloudflare Workers AI fallback (used when Groq fails)
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# Optional model override (default: @cf/openai/gpt-oss-20b)
# CF_MODEL=@cf/openai/gpt-oss-20b

# Optional service overrides
# PORT=8000
# CHROME_PATH=/usr/bin/google-chrome
# SOFFICE_BIN=soffice
